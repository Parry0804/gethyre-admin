# GetHyre Admin — environment keys
# Copy to .env.local for your machine, or add them in Vercel → Project → Settings → Environment Variables.
# These are build-time settings for a browser app: everything here is visible to anyone who opens the site,
# so NEVER put passwords, database URLs or API secrets in a VITE_ key. Secrets belong to the backend.

# true  = use the built-in sample data (test link, demo sign-in pranay / gethyre-demo)
# false = talk to the real backend at VITE_API_URL
VITE_USE_MOCKS=true

# Base URL of the backend API, without a trailing slash. Leave empty while VITE_USE_MOCKS=true,
# or when the backend is served from the same domain as the panel.
# Example: https://api.gethyre.ai
VITE_API_URL=
